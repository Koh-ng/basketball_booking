# Postgres connection string (Neon: dùng pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname

# Mã PIN đăng nhập trang quản lý /admin
ADMIN_PIN=123456

# Secret bảo vệ endpoint cron (đặt chuỗi ngẫu nhiên dài)
CRON_SECRET=thay-bang-chuoi-ngau-nhien

# Resend (https://resend.com) để gửi email nhắc admin — bỏ trống nếu chưa cần
RESEND_API_KEY=
# Email người gửi (mặc định dùng onboarding@resend.dev của Resend)
EMAIL_FROM=
# Email admin nhận nhắc nhở (có thể đặt trong trang Cài đặt thay vì ở đây)
ADMIN_EMAIL=

# URL public của app (để chèn link vào tin nhắn), VD: https://bongro.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
