# Postgres connection string (Neon: dùng pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname

# Mã PIN đăng nhập trang quản lý /admin
ADMIN_PIN=123456

# Secret bảo vệ endpoint cron (đặt chuỗi ngẫu nhiên dài)
CRON_SECRET=thay-bang-chuoi-ngau-nhien

# Gửi email nhắc admin qua Gmail SMTP (miễn phí, gửi được tới bất kỳ ai,
# không cần verify domain) — bỏ trống nếu chưa cần email.
# 1. Bật xác minh 2 bước cho tài khoản Gmail dùng để gửi
# 2. Tạo mật khẩu ứng dụng ở https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Email admin nhận nhắc nhở (có thể đặt trong trang Cài đặt thay vì ở đây)
ADMIN_EMAIL=

# URL public của app (để chèn link vào tin nhắn), VD: https://bongro.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
